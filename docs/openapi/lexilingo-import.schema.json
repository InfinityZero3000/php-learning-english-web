{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-english.local/schemas/lexilingo-import.json",
  "$comment": "Derived from InfinityZero3000/LexiLingo commit b4ce2f73b3dc5d6353bc35ff33aa38f11d0d617b",
  "$defs": {
    "Meta": {
      "type": ["object", "array"],
      "additionalProperties": true
    },
    "Category": {
      "type": "object",
      "required": ["id", "name", "slug", "description", "icon", "color", "course_count"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "icon": { "type": ["string", "null"] },
        "color": { "type": ["string", "null"] },
        "course_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "CategoryDetail": {
      "allOf": [
        { "$ref": "#/$defs/Category" },
        {
          "type": "object",
          "required": ["order_index", "is_active"],
          "properties": {
            "order_index": { "type": "integer" },
            "is_active": { "type": "boolean" }
          }
        }
      ]
    },
    "Course": {
      "type": "object",
      "required": ["id", "title", "description", "language", "level", "tags", "thumbnail_url", "total_lessons", "total_xp", "estimated_duration"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "language": { "type": "string", "minLength": 1 },
        "level": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "thumbnail_url": { "type": ["string", "null"] },
        "total_lessons": { "type": "integer", "minimum": 0 },
        "total_xp": { "type": "integer", "minimum": 0 },
        "estimated_duration": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "LessonOutline": {
      "type": "object",
      "required": ["id", "title", "order_index", "lesson_type", "xp_reward"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "order_index": { "type": "integer" },
        "lesson_type": { "type": "string", "minLength": 1 },
        "xp_reward": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "Unit": {
      "type": "object",
      "required": ["id", "title", "description", "order_index", "background_color", "icon_url", "lessons"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "order_index": { "type": "integer" },
        "background_color": { "type": ["string", "null"] },
        "icon_url": { "type": ["string", "null"] },
        "lessons": { "type": "array", "items": { "$ref": "#/$defs/LessonOutline" } }
      },
      "additionalProperties": true
    },
    "CategoryListResponse": {
      "type": "object",
      "required": ["data", "meta"],
      "properties": {
        "data": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/Category" } },
        "meta": { "$ref": "#/$defs/Meta" }
      },
      "additionalProperties": true
    },
    "CategoryDetailResponse": {
      "type": "object",
      "required": ["data", "meta"],
      "properties": {
        "data": { "$ref": "#/$defs/CategoryDetail" },
        "meta": { "$ref": "#/$defs/Meta" }
      },
      "additionalProperties": true
    },
    "Pagination": {
      "type": "object",
      "required": ["total_pages"],
      "properties": {
        "total_pages": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "PaginatedCourseResponse": {
      "type": "object",
      "required": ["data", "pagination", "meta"],
      "properties": {
        "data": { "type": "array", "items": { "$ref": "#/$defs/Course" } },
        "pagination": { "$ref": "#/$defs/Pagination" },
        "meta": { "$ref": "#/$defs/Meta" }
      },
      "additionalProperties": true
    },
    "CourseDetailResponse": {
      "type": "object",
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "allOf": [
            { "$ref": "#/$defs/Course" },
            {
              "type": "object",
              "required": ["units"],
              "properties": {
                "units": { "type": "array", "items": { "$ref": "#/$defs/Unit" } }
              }
            }
          ]
        },
        "meta": { "$ref": "#/$defs/Meta" }
      },
      "additionalProperties": true
    },
    "ExerciseOption": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "is_correct": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "Exercise": {
      "type": "object",
      "required": ["id", "type", "question", "correct_answer"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["multiple_choice", "true_false", "fill_blank", "translate", "matching", "reorder"] },
        "ui_type": { "type": ["string", "null"] },
        "question": { "type": "string", "minLength": 1 },
        "options": { "type": ["array", "null"], "items": { "$ref": "#/$defs/ExerciseOption" } },
        "correct_answer": { "type": "string" },
        "explanation": { "type": ["string", "null"] },
        "hint": { "type": ["string", "null"] },
        "audio_url": { "type": ["string", "null"] },
        "image_url": { "type": ["string", "null"] },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "points": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "LessonContentResponse": {
      "type": "object",
      "required": ["data"],
      "properties": {
        "data": {
          "type": "object",
          "required": ["id", "title", "lesson_type", "order_index", "xp_reward", "pass_threshold", "estimated_minutes", "total_exercises", "exercises"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": ["string", "null"] },
            "lesson_type": { "type": "string", "minLength": 1 },
            "order_index": { "type": "integer" },
            "xp_reward": { "type": "integer", "minimum": 0 },
            "pass_threshold": { "type": "integer", "minimum": 0 },
            "estimated_minutes": { "type": "integer", "minimum": 0 },
            "total_exercises": { "type": "integer", "minimum": 0 },
            "exercises": { "type": "array", "items": { "$ref": "#/$defs/Exercise" } }
          },
          "additionalProperties": true
        },
        "meta": { "$ref": "#/$defs/Meta" }
      },
      "additionalProperties": true
    },
    "VocabularyItem": {
      "type": "object",
      "required": ["id", "course_id", "lesson_id", "word", "definition", "translation", "pronunciation", "audio_url", "part_of_speech", "difficulty_level", "tags", "usage_frequency"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "course_id": { "type": ["string", "null"], "minLength": 1 },
        "lesson_id": { "type": ["string", "null"], "minLength": 1 },
        "word": { "type": "string", "minLength": 1 },
        "definition": { "type": "string" },
        "translation": { "type": ["object", "null"], "additionalProperties": { "type": "string" } },
        "pronunciation": { "type": ["string", "null"] },
        "audio_url": { "type": ["string", "null"] },
        "part_of_speech": { "type": "string", "minLength": 1 },
        "difficulty_level": { "type": "string", "minLength": 1 },
        "tags": { "type": ["array", "null"], "items": { "type": "string" } },
        "usage_frequency": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "VocabularyItemList": {
      "type": "array",
      "items": { "$ref": "#/$defs/VocabularyItem" }
    }
  }
}
